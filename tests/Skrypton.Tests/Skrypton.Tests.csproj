<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableParallelization>true</EnableParallelization>
    <NoWarn>$(NoWarn);8981;MSTEST0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Skrypton\Skrypton.csproj" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="VbsResources\**\*.cs" />
    <None Include="VbsResources\**\*.cs" />
    <EmbeddedResource Include="VbsResources\**\*.sql" />
    <EmbeddedResource Include="VbsResources\**\*.vbs" />
    <EmbeddedResource Include="VbsResources\**\*.xml" />
    <EmbeddedResource Include="VbsResources\**\*.cs" />
    <EmbeddedResource Include="VbsResources\**\*.cstxt" />
    <EmbeddedResource Include="VbsResources\**\*.expected.txt" />
    <EmbeddedResource Include="VbsResources\**\*.cases.txt" />
    <EmbeddedResource Include="VbsResources\**\*.template.docx" />
    <EmbeddedResource Include="VbsResources\**\*.template.xlsx" />
    <!-- the demos that use only the built-ins (ComParityTests.DemoScript - the others run in Skrypton.Windows.Tests, issue #142) -->
    <EmbeddedResource Include="..\..\samples\Windows\Excel-Report.*;..\..\samples\Windows\FileSystem-Inventory.*;..\..\samples\Windows\Word-Letter.*" LogicalName="Skrypton.Tests.Samples.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Skrypton\" />
  </ItemGroup>

</Project>
