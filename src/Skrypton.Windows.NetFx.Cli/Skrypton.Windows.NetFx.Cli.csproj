<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs VBScript files from the command line like cscript.exe (.NET Framework 4.8) - the Program.cs of Skrypton.Windows.Cli -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1303</NoWarn> <!-- the help text is not localized -->
    <RootNamespace>Skrypton.Windows.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Skrypton.Windows.Cli\Program.cs" Link="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skrypton.Windows.NetFx\Skrypton.Windows.NetFx.csproj" />
  </ItemGroup>
</Project>
