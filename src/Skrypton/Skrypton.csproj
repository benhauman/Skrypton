<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SignAssembly>True</SignAssembly>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!--<NoWarn>SUPPRESS your CA(s) CAxxx;CAyyy</NoWarn>-->
    <!--<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors />-->

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!--<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />-->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

  <!--
    The package contains the command line tools, ready to run from the package folder:
      tools\Skrypton.Windows.Cli\Skrypton.Windows.Cli.exe              (.NET 10, Windows x64)
      tools\Skrypton.Windows.NetFx.Cli\Skrypton.Windows.NetFx.Cli.exe  (.NET Framework 4.8)
    They are published when the package is packed on Windows (the Windows only projects cannot be built for the package elsewhere).
  -->
  <PropertyGroup>
    <IncludeCommandLineToolsInPackage Condition="'$(IncludeCommandLineToolsInPackage)' == '' and '$(OS)' == 'Windows_NT'">true</IncludeCommandLineToolsInPackage>
    <NoWarn>$(NoWarn);NU5100</NoWarn> <!-- the assemblies of the command line tools are in tools, not in lib -->
    <CommandLineToolsPublishDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)cli\</CommandLineToolsPublishDir>
  </PropertyGroup>
  <Target Name="IncludeCommandLineToolsInPackage" BeforeTargets="_GetPackageFiles" Condition="'$(IncludeCommandLineToolsInPackage)' == 'true'">
    <RemoveDir Directories="$(CommandLineToolsPublishDir)" />
    <MSBuild Projects="..\Skrypton.Windows.Cli\Skrypton.Windows.Cli.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(CommandLineToolsPublishDir)Skrypton.Windows.Cli\" />
    <MSBuild Projects="..\Skrypton.Windows.NetFx.Cli\Skrypton.Windows.NetFx.Cli.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);PublishDir=$(CommandLineToolsPublishDir)Skrypton.Windows.NetFx.Cli\" />
    <ItemGroup>
      <!-- without the translations of the compiler messages (the cs, de, .. resource folders of Roslyn) -->
      <_CommandLineToolFile Include="$(CommandLineToolsPublishDir)**\*" Exclude="$(CommandLineToolsPublishDir)**\*.pdb;$(CommandLineToolsPublishDir)**\*.resources.dll" />
      <Content Include="@(_CommandLineToolFile)" Pack="true" PackagePath="tools\%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
