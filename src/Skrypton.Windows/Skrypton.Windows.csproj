<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The host services of Windows for Skrypton (process control, clipboard, MsgBox / InputBox, ADODB through OLE DB, Outlook through its COM
    automation), the WScript object and the script runner of the command line tools. Skrypton.Windows.NetFx compiles the same sources for the
    .NET Framework.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- The sources are shared with Skrypton.Windows.NetFx (net481), which has none of the APIs these rules propose
         (ArgumentNullException.ThrowIfNull, string.StartsWith(char), SearchValues) -->
    <NoWarn>$(NoWarn);CA1510;CA1865;CA1870</NoWarn>
    <PackageId>Skrypton.Windows</PackageId>
    <Description>Skrypton on Windows (.NET): the Windows host services (processes, clipboard, dialogs, ADO through OLE DB, Outlook) and the script runner of the skrypton command line tool</Description>
    <PackageTags>Skrypton;VBScript;Windows</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skrypton\Skrypton.csproj" />
    <PackageReference Include="System.Data.OleDb" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
