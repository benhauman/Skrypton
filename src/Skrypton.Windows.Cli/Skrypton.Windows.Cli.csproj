<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs VBScript files from the command line like cscript.exe (.NET, Windows) - see Program.cs (shared with Skrypton.Windows.NetFx.Cli) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1865;CA1303</NoWarn> <!-- shared with net48; the help text is not localized -->
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skrypton.Windows\Skrypton.Windows.csproj" />
  </ItemGroup>
</Project>
